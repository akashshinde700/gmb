# WebSetu — copy to .env and fill in. Never commit the filled-in file.

# --- required ---
# Relative to prisma/schema.prisma.
DATABASE_URL=file:../db/custom.db
# Must match the provider in prisma/schema.prisma. Search filters read this to
# stay case-insensitive on PostgreSQL, where `contains` is case-sensitive.
# Switch both with: npm run db:use postgresql
# DATABASE_PROVIDER is no longer read: the provider is taken from the scheme
# of DATABASE_URL above, so the two can never disagree.
# HMAC key for session tokens. Minimum 16 characters; the server refuses to
# start in production without it. Generate: openssl rand -hex 32
APP_SECRET=
# Absolute origin, used for canonical URLs, sitemap entries, OG tags and the
# links inside transactional email.
NEXT_PUBLIC_APP_URL=https://www.websetu.instantqr.tech

# --- transactional email (lead alerts, welcome, subscription lifecycle) ---
# Without these the app still works; alerts are only written in-app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WebSetu
# Self-imposed ceiling so one runaway loop cannot burn the provider's daily
# quota and silence every alert until midnight.
SMTP_DAILY_CAP=400
SUPPORT_EMAIL=

# --- SMS lead alerts via httpSMS (https://httpsms.com) ---
# One Android phone running the httpSMS app acts as the gateway for the whole
# platform, so the allowance below is shared by every tenant. Alerts go to the
# business owner's own number only — never to a website visitor.
HTTPSMS_API_KEY=
# The gateway phone's own number, E.164. Without it SMS stays disabled.
HTTPSMS_FROM=
# Stay below the provider's monthly limit (200 on the free tier).
HTTPSMS_MONTHLY_CAP=180
# Shared secret configured on the httpSMS webhook, for verifying callbacks.
HTTPSMS_WEBHOOK_SIGNING_KEY=

# --- payments (Razorpay) ---
# With a key set, the simulated checkout is refused and real orders are created.
# Leave blank to keep the demo behaviour.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay -> Settings -> Webhooks. Without it webhook events are rejected,
# and a customer whose browser dies mid-payment is only activated when they
# return to the page.
RAZORPAY_WEBHOOK_SECRET=
# GST added on top of the listed plan price. Leave at 0 while WebSetu is not
# GST registered: a rate here charges tax that cannot legally be collected.
# Set it to 18 (the SaaS rate in India) together with PLATFORM_GSTIN below on
# the day registration comes through. Stored on every payment, so changing it
# never rewrites an old receipt.
GST_RATE=0

# --- tax invoice (supplier details printed on every invoice) ---
# Without PLATFORM_GSTIN the document is issued as a "Payment Receipt" rather
# than a "Tax Invoice", because a tax invoice without a GSTIN is worthless to
# the customer and misleading on its face.
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
# The supplier's state. Decides CGST+SGST (same state) vs IGST (different).
PLATFORM_STATE=
# SAC code for the service. 998314 covers SaaS / IT infrastructure support.
PLATFORM_SAC=998314

# --- customer domains ---
# Where customers point their DNS. The dashboard prints these as the record to
# create, and verification refuses to activate a domain that resolves elsewhere.
DOMAIN_TARGET_HOST=www.websetu.instantqr.tech
# Public IPv4 of this server, for apex domains that cannot carry a CNAME.
# Comma-separated if there is more than one.
DOMAIN_TARGET_IPS=
# Hostnames that belong to the platform and can never be claimed by a tenant.
# NEXT_PUBLIC_APP_URL's host and localhost are always included.
PLATFORM_HOSTS=

# Days of raw analytics events kept before they are folded into daily totals
# and deleted. The dashboard's numbers are unaffected either way.
ANALYTICS_RETENTION_DAYS=45

# --- optional ---
# Days a lapsed paid subscription keeps serving before the site goes dark.
SUBSCRIPTION_GRACE_DAYS=5
# Free trial length. Inlined at build time, so changing it needs a rebuild.
NEXT_PUBLIC_TRIAL_DAYS=3
# Simulated checkout. Leave unset in production until a real gateway is wired.
ALLOW_MOCK_PAYMENTS=false
# Where uploaded images are written. Must be a persistent volume.
UPLOADS_DIR=
# Prints every SQL statement, parameters included. Debugging only.
PRISMA_LOG_QUERIES=0

# --- AI content generation (any one provider) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_MS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
