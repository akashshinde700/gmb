// WebSetu — Multi-Tenant Business Website SaaS Platform
// SQLite (no native enums) → statuses stored as strings

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN | RESELLER
  notifyJson   String   @default("{}") // {leadAlerts, weekly, productUpdates}
  /// Bumped to invalidate every session token already issued for this user —
  /// on a password change, or an explicit "sign out everywhere".
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business?
  notifications Notification[]
  resetTokens   PasswordReset[]
  reseller      Reseller?
}

/// An agency, hosting company or SaaS that sells websites under its own brand.
///
/// The point is that their customer never learns WebSetu exists: the brand
/// below replaces the platform's name, logo and colours on the reseller's own
/// hostname, and their API key lets their product create a website in one call
/// without a human in the loop.
model Reseller {
  id String @id @default(cuid())
  /// The agency's own login. One reseller per account.
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What clients see. Empty means "use the platform's name".
  brandName    String @default("")
  logoUrl      String @default("")
  supportEmail String @default("")
  /// Brand colour for the platform pages served on their hostname.
  primaryColor String @default("")
  /// Their own app domain (app.theiragency.com). Empty = not set up yet.
  hostname     String @unique @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys ApiKey[]
  sites   Business[]

  @@index([hostname])
}

/// One API key. The key itself is shown once, at creation, and only its hash is
/// stored — a leaked database must not hand somebody the ability to mint sites.
model ApiKey {
  id         String    @id @default(cuid())
  resellerId String
  reseller   Reseller  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  label      String    @default("")
  hash       String    @unique
  /// First characters of the key, so a human can tell two keys apart in a list.
  prefix     String    @default("")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([resellerId, createdAt])
}

model Business {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  slug                String    @unique
  /// Which reseller's client this is, when an agency created it through the API.
  resellerId          String?
  reseller            Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  /// The caller's own id for this site (their project or order number). Repeating
  /// a call with the same value returns the site that already exists instead of
  /// building a second one.
  apiRef              String    @default("")
  category            String
  tagline             String    @default("")
  description         String    @default("")
  ownerName           String    @default("")
  phone               String    @default("")
  whatsapp            String    @default("")
  email               String    @default("")
  address             String    @default("")
  city                String    @default("")
  state               String    @default("")
  country             String    @default("India")
  pincode             String    @default("")
  establishedYear     String    @default("")
  gstin               String    @default("")
  logoUrl             String    @default("")
  coverUrl            String    @default("")
  brandPrimary        String    @default("#059669")
  brandSecondary      String    @default("#0f766e")
  brandAccent         String    @default("#f59e0b")
  templateId          String    @default("")
  gmbUrl              String    @default("")
  mapsUrl             String    @default("")
  placeId             String    @default("")
  upiId               String    @default("") // UPI VPA e.g. name@okicici — used for payment QR
  paymentQrUrl        String    @default("") // custom QR image (dataURL or hosted URL); auto-generated when empty
  hoursJson           String    @default("{}") // {mon:"9:00-18:00",...} + {days:[...]}
  socialsJson         String    @default("{}") // {facebook,instagram,youtube,linkedin,x,pinterest}
  status              String    @default("DRAFT") // DRAFT | PUBLISHED | SUSPENDED | EXPIRED | ARCHIVED
  // Per-customer palette override set by an admin: JSON array of Palette ids.
  // Empty means "follow the plan allowance".
  allowedPalettesJson String    @default("")
  /// Custom domains this customer has paid for, granted by an admin.
  ///
  /// Domains are sold as an add-on rather than bundled into a plan, so this —
  /// not the plan — is where the entitlement normally comes from. It adds to
  /// whatever the plan allows, so bundling one into a tier later still works.
  domainCredits       Int       @default(0)
  aiUsedCount         Int       @default(0) // AI generations used in the current period
  // Appearance edits (theme / brand colours) used while on a free or trial plan.
  themeChangesUsed    Int       @default(0)
  // Google reviews cached from the Places API, with the time they were fetched.
  // Per-field provenance of anything imported from a named source:
  // { phone: { value, source: "google"|"link"|"owner", at } }. What is not in
  // here was typed by the owner, and nothing here was invented.
  factsJson           String    @default("{}")
  /// How this business sells online: { enabled, deliveryCharge, freeDeliveryAbove,
  /// minOrder, pickup, cod }. Written by the Orders settings card; read by the
  /// storefront cart, so the shipping rule the customer sees is the owner's.
  commerceJson        String    @default("{}")
  googleReviewsJson   String    @default("[]")
  googleReviewsAt     DateTime?
  aiPeriodStart       DateTime  @default(now()) // rolls forward every 30 days
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  website        Website?
  domains        Domain[]
  domainRequests DomainRequest[]
  services       Service[]
  products       Product[]
  gallery        GalleryItem[]
  testimonials   Testimonial[]
  faqs           Faq[]
  blogPosts      BlogPost[]
  leads          Lead[]
  orders         Order[]
  subscription   Subscription?
  payments       Payment[]
  analytics      AnalyticsEvent[]

  @@index([status])
  @@index([templateId])
  @@index([resellerId, apiRef])
}

model Website {
  id             String    @id @default(cuid())
  businessId     String    @unique
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  keywords       String    @default("")
  ogImage        String    @default("")
  themeJson      String    @default("{}") // {font, radius, containerWidth, heroStyle, cardStyle}
  sectionsJson   String    @default("[]") // ordered [{id,type,visible,content}]
  version        Int       @default(1)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  image       String   @default("")
  icon        String   @default("sparkles")
  price       String   @default("")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([businessId, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  sku         String   @default("")
  category    String   @default("")
  shortDesc   String   @default("")
  description String   @default("")
  price       Float?
  salePrice   Float?
  image       String   @default("")
  videoUrl    String   @default("") // YouTube link for the product demo/review
  hidePrice   Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([businessId, sortOrder])
}

model GalleryItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  caption    String   @default("")
  alt        String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, sortOrder])
}

model Testimonial {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  role       String   @default("")
  content    String
  rating     Int      @default(5)
  avatar     String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, sortOrder])
}

model Faq {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  excerpt     String    @default("")
  content     String    @default("")
  cover       String    @default("")
  author      String    @default("")
  category    String    @default("")
  tags        String    @default("") // comma separated
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, slug])
  @@index([businessId, published, publishedAt])
}

model Lead {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String   @default("")
  message     String   @default("")
  source      String   @default("FORM") // FORM | WHATSAPP | CALL
  serviceName String   @default("")
  status      String   @default("NEW") // NEW | CONTACTED | FOLLOW_UP | QUALIFIED | CONVERTED | CLOSED | SPAM
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([createdAt])
}

/// One thing a customer bought on a tenant's website.
///
/// Prices are copied onto the order at the moment it is placed, from the
/// database and never from the request — a cart that says ₹1 for a ₹1,999
/// product is a cart the owner would have to honour. The copy is also what
/// makes an old order readable after the product is deleted or re-priced.
model Order {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The number the shop and the customer both quote, e.g. "ORD-1042".
  number       String   @unique
  customerName String
  phone        String
  email        String   @default("")
  address      String   @default("")
  notes        String   @default("")
  /// [{ productId, name, qty, price }] as JSON — the lines as they were sold.
  itemsJson    String   @default("[]")
  subtotal     Float    @default(0)
  delivery     Float    @default(0)
  total        Float    @default(0)
  /// DELIVERY | PICKUP
  fulfilment   String   @default("DELIVERY")
  /// COD | UPI | ENQUIRY
  payment      String   @default("COD")
  /// PENDING | PAID | REFUNDED
  paymentStatus String  @default("PENDING")
  /// What the customer typed after paying by UPI (a UTR, usually).
  paymentRef   String   @default("")
  /// NEW | CONFIRMED | PACKED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  status       String   @default("NEW")
  /// The owner's private note about this order.
  ownerNotes   String   @default("")
  /// The enquiry this order also filed, so the lead inbox and the order list
  /// point at each other instead of the order disappearing into a second inbox.
  leadId       String   @default("")
  /// Which visit placed it — the same id the analytics events carry.
  visitId      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, phone])
}

model Plan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tagline             String   @default("")
  priceMonthly        Float
  priceYearly         Float
  featuresJson        String   @default("[]")
  maxPages            Int      @default(5) // -1 = unlimited
  aiCredits           Int      @default(0)
  maxPalettes         Int      @default(-1) // brand palettes this plan may pick from; -1 = all
  // Appearance changes allowed before an upgrade is required; -1 = unlimited.
  maxThemeChanges     Int      @default(-1)
  // Custom domains this plan may connect. 0 = not offered, -1 = unlimited.
  maxDomains          Int      @default(0)
  // Set when this plan was created for one customer only ("Custom — Acme").
  // Such plans are hidden from public pricing and from the plan picker.
  customForBusinessId String?
  popular             Boolean  @default(false)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id          String    @id @default(cuid())
  businessId  String    @unique
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  cycle       String    @default("MONTHLY") // MONTHLY | YEARLY
  status      String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | EXPIRED | CANCELED
  amount      Float     @default(0)
  startedAt   DateTime  @default(now())
  renewsAt    DateTime?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([planId])
}

model Payment {
  id               String    @id @default(cuid())
  // Nullable + SetNull: deleting a business must not erase its payment history.
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subscriptionId   String?
  amount           Float
  method           String    @default("UPI") // UPI | CARD | NETBANKING
  status           String    @default("SUCCESS") // SUCCESS | FAILED | REFUNDED
  invoiceNo        String    @default("")
  /// The gateway's own payment id. Kept as a column rather than buried in the
  /// description so a refund webhook can find the row it refers to.
  gatewayPaymentId String    @default("")
  /// GST breakdown, kept alongside the total so an invoice can be reproduced
  /// exactly as it was charged — the rate is stored, not assumed, because a
  /// rate change must not rewrite last year's invoices.
  taxableAmount    Float     @default(0)
  taxRate          Float     @default(0)
  taxAmount        Float     @default(0)
  /// The GST split, stored rather than derived. Which of these applies depends
  /// on the customer's state at the time of sale, and a customer who later
  /// moves must not silently rewrite an invoice already filed with a return.
  cgst             Float     @default(0)
  sgst             Float     @default(0)
  igst             Float     @default(0)
  /// Place of supply — the customer's state. Required on a GST invoice.
  placeOfSupply    String    @default("")
  /// The customer's GSTIN when they gave one; without it on the invoice they
  /// cannot claim input tax credit.
  customerGstin    String    @default("")
  /// Billing name and address as they stood at the time of sale.
  billToJson       String    @default("{}")
  couponCode       String    @default("")
  description      String    @default("")
  createdAt        DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([invoiceNo])
  @@index([gatewayPaymentId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("PERCENT") // PERCENT | FIXED
  value       Float
  description String    @default("")
  active      Boolean   @default(true)
  expiresAt   DateTime?
  maxUses     Int       @default(100)
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String   @default("local") // industry fit
  description String   @default("")
  premium     Boolean  @default(false)
  themeJson   String   @default("{}") // default theme overrides
  gradient    String   @default("from-emerald-500 to-teal-600")
  coverImage  String   @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // VISIT | CTA_CALL | CTA_WHATSAPP | CTA_EMAIL | CTA_DIRECTIONS | FORM_SUBMIT
  path       String   @default("/")
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, type, createdAt])
}

model PlatformLead {
  id           String   @id @default(cuid())
  name         String
  email        String   @default("")
  phone        String   @default("")
  businessType String   @default("")
  message      String   @default("")
  source       String   @default("CONTACT") // CONTACT | DEMO | SALES
  status       String   @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  createdAt    DateTime @default(now())

  followUps PlatformLeadFollowUp[]

  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   @default("")
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// One provider attempt — what the AI manager routed where, and what it cost.
///
/// Every call to a model is recorded, including the failures: the whole point of
/// the provider chain is that a provider can be rate-limited, overloaded or
/// out of credit without the customer noticing, and the only way to know that is
/// happening is to count it.
model LlmUsage {
  id         String   @id @default(cuid())
  /// What was being written: content | copy | seo | faq | chat.
  task       String   @default("content")
  provider   String
  model      String   @default("")
  ok         Boolean  @default(true)
  /// How long the attempt took, whether or not it succeeded.
  latencyMs  Int      @default(0)
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  /// Estimated, from the price table — not a bill.
  costUsd    Float    @default(0)
  /// First line of the failure, for the admin view.
  error      String   @default("")
  businessId String   @default("")
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([task, createdAt])
  @@index([createdAt])
}

/// A customer's own domain pointed at their WebSetu site.
///
/// The hostname is the routing key: `proxy.ts` looks up the incoming Host
/// header here and rewrites the request onto /s/<business slug>. It is also
/// what Caddy asks about before issuing a certificate, so a row only becomes
/// ACTIVE once its DNS has been seen to point at us — otherwise anyone could
/// claim a hostname and have certificates issued for it.
model Domain {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Lower-cased, punycode, no port, no trailing dot. Unique across the platform.
  hostname    String    @unique
  /// PENDING (awaiting DNS) | ACTIVE (verified, serving) | FAILED (checks exhausted)
  status      String    @default("PENDING")
  /// Random value the customer publishes as a TXT record to prove ownership.
  token       String
  /// The canonical hostname for this business. Others 308 to it, so a site is
  /// never indexed twice under two names.
  primary     Boolean   @default(false)
  lastCheckAt DateTime?
  lastError   String    @default("")
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([status])
}

/// A single-use password reset link.
///
/// Only the hash of the token is stored: a leaked database must not hand out
/// working reset links for every account that has one outstanding.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Pre-aggregated analytics, one row per business per day per event type.
///
/// AnalyticsEvent grows by one row per page view for ever. The rollup keeps the
/// numbers the dashboard actually shows while letting the raw rows be deleted
/// past the retention window, so storage stops tracking traffic.
model AnalyticsDaily {
  id          String @id @default(cuid())
  businessId  String
  /// UTC calendar day as YYYY-MM-DD — stored as text so the grouping does not
  /// depend on the database's own date functions.
  day         String
  type        String
  count       Int    @default(0)
  /// Distinct paths seen that day, for the "unique visits" figure.
  uniquePaths Int    @default(0)

  @@unique([businessId, day, type])
  @@index([businessId, day])
}

/// Platform-wide key/value settings (e.g. the marketing + login colour palette).
/// Single-row-per-key by design: `key` is the primary key.
model Setting {
  key       String   @id
  value     String   @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

/// Brand colour palettes offered in the tenant website pickers and, when the
/// scope allows, for WebSetu's own landing + login pages. Seeded from
/// src/lib/palettes.ts on first read; admins can add their own on top.
model Palette {
  id        String   @id @default(cuid())
  name      String   @unique
  mood      String   @default("")
  primary   String
  secondary String
  accent    String
  scope     String   @default("BOTH") // BUSINESS | PLATFORM | BOTH
  active    Boolean  @default(true)
  builtIn   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active, sortOrder])
}

/// A note recorded against a platform enquiry — who chased it, when, and what
/// was said. Enquiries without a trail are enquiries nobody follows up.
model PlatformLeadFollowUp {
  id        String       @id @default(cuid())
  leadId    String
  lead      PlatformLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note      String
  actor     String       @default("")
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
}

/// WebSetu's own marketing blog (separate from the per-tenant BlogPost model).
model PlatformPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  cover       String    @default("")
  author      String    @default("")
  tags        String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// "Buy a domain for me": the customer asks, an admin quotes and registers it,
/// the customer pays for the domain separately, then it is connected.
model DomainRequest {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Preferred hostname, lower-cased (e.g. shreeganeshroadways.com)
  domain       String
  /// Comma-separated fallbacks if the first choice is taken
  alternatives String   @default("")
  note         String   @default("")
  /// What RDAP said when the request was made: AVAILABLE | TAKEN | UNKNOWN
  availability String   @default("UNKNOWN")
  /// REQUESTED | QUOTED | PAID | CONNECTED | CANCELLED
  status       String   @default("REQUESTED")
  /// Price quoted to the customer for the domain (₹, per year), paid separately
  quotedPrice  Float?
  adminNote    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([status, createdAt])
}
