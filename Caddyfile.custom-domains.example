# WebSetu — Caddy configuration for customer domains.
#
# NOT IN USE. The production server is fronted by nginx under CloudPanel, where
# a customer domain gets its certificate when its vhost is created, one at a
# time. This file is the alternative: it makes certificates automatic, and is
# worth switching to when adding vhosts by hand stops being practical.
#
# Copy the relevant blocks into the server's real Caddyfile. The existing
# reverse_proxy block for the platform host stays exactly as it is; everything
# here is additive.
#
# What this does: any hostname that is NOT one of the platform's own gets a
# certificate issued on first request, but only after Caddy has asked WebSetu
# whether it recognises that hostname. Without the `ask` endpoint, Caddy would
# request a certificate for every domain anyone points at this IP address —
# which is how a server gets rate-limited by Let's Encrypt for a week.

{
	# Global option. `ask` is called with ?domain=<hostname> before any
	# certificate is obtained for a hostname Caddy has not seen before.
	# WebSetu answers 200 only for domains a customer has added AND whose DNS
	# has been observed pointing here.
	on_demand_tls {
		ask http://127.0.0.1:3000/api/domains/check
		# Ceiling on new certificates, as a second line of defence if the ask
		# endpoint is ever misconfigured.
		interval 2m
		burst 5
	}
}

# The platform's own hostname keeps a normal, non-on-demand certificate.
www.websetu.instantqr.tech {
	reverse_proxy localhost:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# Every customer domain. The empty site address matches any hostname that no
# earlier block claimed, so this must stay last.
https:// {
	tls {
		on_demand
	}

	reverse_proxy localhost:3000 {
		# Host must be passed through unchanged: it is the only thing that tells
		# the app which tenant this request belongs to.
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# ---------------------------------------------------------------------------
# What the customer does at their registrar
#
#   Subdomain (www.yourshop.com), the recommended setup:
#       Type: CNAME    Name: www    Value: www.websetu.instantqr.tech
#
#   Apex domain (yourshop.com), where most registrars forbid a CNAME:
#       Type: A        Name: @      Value: <this server's public IP>
#     or an ALIAS/ANAME record pointing at www.websetu.instantqr.tech
#
# Set the matching values in .env so the dashboard prints the right instructions
# and verification knows what to look for:
#
#   DOMAIN_TARGET_HOST=www.websetu.instantqr.tech
#   DOMAIN_TARGET_IPS=203.0.113.10
#
# ---------------------------------------------------------------------------
# Checks after deploying
#
#   curl -s -o /dev/null -w '%{http_code}\n' \
#     'http://127.0.0.1:3000/api/domains/check?domain=www.customer.com'
#       200 for a verified domain, 404 for anything else.
#
#   curl -sI https://www.customer.com | head -1
#       200 once DNS has propagated and the certificate has been issued.
#
# The first request to a new domain is slow — Caddy is obtaining the
# certificate while it waits. That is normal and happens once.
