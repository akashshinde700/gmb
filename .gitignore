# Playwright
/e2e/.auth/
/test-results/
/playwright-report/

# The local SQLite database. It was tracked, which put real users, scrypt
# password hashes, leads and payment rows into every clone of this repo — and
# made a binary merge conflict out of every commit. Production's database lives
# outside the repo entirely (persistent/websetu.db on the server).
/db/
*.db
*.db-journal

# Stitch design keys — design-time only, never deployed
stitch-keys.local.json

# Customer-uploaded images live in UPLOADS_DIR on the server, not in git
public/uploads/
__pycache__/

# Patch/bundle artifacts of a session's work. A 1.4 MB `GMB-PATCH-*.patch`
# holding a diff of already-merged commits was committed this way, and the
# standalone build then copied it into the deployable output. If a patch is
# worth keeping, it belongs in the pull request, not in the tree.
*.patch
*.diff
*.bundle
*.zip
!*/public/**/*.zip
