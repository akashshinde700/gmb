+  } else {
+    failed++;
+    console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ""}`);
+  }
+}
+
+const SECTIONS: SectionType[] = [
+  "hero", "stats", "about", "services", "products", "whyUs", "gallery",
+  "testimonials", "faq", "blog", "cta", "payment", "hours", "contact",
