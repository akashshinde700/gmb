+import type { SectionType, SiteSection } from "@/lib/types";
+import {
+  sectionPlanFor,
+  type ButtonChoice,
+  type DesignTokens,
+  type FontChoice,
+  type FooterChoice,
+  type HeaderChoice,
+  type ImageTreatment,
+  type RadiusChoice,
