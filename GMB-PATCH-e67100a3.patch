+import type { Metadata } from "next";
+import { db } from "@/lib/db";
+import { requirePageBusiness } from "@/lib/guard";
+import VisualEditor from "@/components/editor/visual-editor";
+
+/**
+ * The freeform visual editor, at its own URL.
+ *
+ * Deliberately not a dashboard tab: the editor is a full-bleed canvas, and the
+ * console's card layout would either constrain it or have to be special-cased
+ * for it. A separate route also means the owner can keep it open in a second tab
+ * while the dashboard sits in the first.
+ *
+ * The guard is the same server-side one every console page uses, so a signed-out
+ * visitor is redirected before any HTML exists.
+ */
+
+export const metadata: Metadata = {
+  title: "Visual editor",
+  robots: { index: false, follow: false },
+};
+
+export default async function EditorPage() {
+  const user = await requirePageBusiness("/editor");
+  const business = await db.business.findUnique({
+    where: { userId: user.id },
+    select: { slug: true },
+  });
+
+  return <VisualEditor slug={business?.slug ?? ""} />;
+}
diff --git a/src/app/globals.css b/src/app/globals.css
index 35c3cb7..f3b31d7 100755
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -213,6 +213,11 @@
 /* Content arriving after a skeleton, or a tab's panel appearing. Kept to a
    fade plus a few pixels: a large slide reads as the page moving, not as
    content settling. */
+@keyframes ws-fade-in {
+  from { opacity: 0 }
+  to { opacity: 1 }
+}
+
 @keyframes ws-enter {
   from { opacity: 0; transform: translateY(4px); }
   to   { opacity: 1; transform: none; }
@@ -430,3 +435,159 @@
     display: none !important;
   }
 }
+
+/* The hero's moving band. One copy of the chips sits beside an identical copy,
+   and the pair slides by exactly half its own width — so the loop is seamless
+   without measuring anything in JavaScript. Readers who prefer less motion get
+   the same band standing still (the global reduced-motion rule above). */
+@keyframes ws-marquee {
+  from { transform: translate3d(0, 0, 0); }
+  to { transform: translate3d(-50%, 0, 0); }
+}
+
+.ws-marquee-wrap {
+  overflow: hidden;
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
+  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
+}
+
+.ws-marquee {
+  display: flex;
+  width: max-content;
+  animation: ws-marquee 34s linear infinite;
+}
+
+.ws-marquee:hover { animation-play-state: paused; }
+
+/* ---------------------------------------------------------------- motion DNA
+   The generator gives every business an animation intensity (0–4, capped at 3
+   in the renderer) and the site carries it as data-anim. These rules let one
+   stylesheet serve all of them instead of the generator fetching a different
+   one per site:
+
+     0–1  calm: reveals become a short fade, the moving extras stop
+     2    the default every existing site already gets
+     3    expressive: a little more travel and a longer, slower reveal
+
+   The moving band and the (optional) floating shapes are the first things to go
+   as intensity drops, because they are decoration on top of content, and the
+   reveal stays in every case so a section never appears half-built. */
+.site-renderer[data-anim="0"] .ws-marquee,
+.site-renderer[data-anim="1"] .ws-marquee,
+.site-renderer[data-anim="0"] .ws-float,
+.site-renderer[data-anim="1"] .ws-float {
+  animation: none !important;
+}
+
+.site-renderer[data-anim="0"] .ws-reveal,
+.site-renderer[data-anim="1"] .ws-reveal {
+  animation-name: ws-fade-in !important;
+  animation-duration: 420ms !important;
+}
+
+/* A genome that asked for almost no motion freezes the hero scene rather than
+   hiding it: the shapes are part of the hero's look, they simply stop moving,
+   and a stopped element costs the phone nothing to composite. */
+.site-renderer[data-anim="0"] .ws-scene *,
+.site-renderer[data-anim="1"] .ws-scene * {
+  animation: none !important;
+}
+
+.site-renderer[data-anim="3"] .ws-shine {
+  animation-duration: 2.2s;
+}
+
+/* A gentle float used by expressive layouts. Transform-only, so it never
+   triggers layout, and it is switched off entirely below intensity 2. */
+@keyframes ws-float {
+  0%, 100% { transform: translate3d(0, 0, 0); }
+  50% { transform: translate3d(0, -10px, 0); }
+}
+
+.ws-float {
+  animation: ws-float 7s ease-in-out infinite;
+}
+
+/* Phones: one notch down, whatever the genome asked for. The animation is
+   decided once, at generation, and this only ever reduces it. */
+@media (max-width: 640px) {
+  .site-renderer[data-anim="3"] .ws-float,
+  .site-renderer[data-anim="2"] .ws-float {
+    animation: none;
+  }
+}
+
+/* ---------- Freeform editor: per-section style the owner sets by hand ----------
+
+   section.content.__style is a small closed vocabulary (lib/section-style.ts).
+   It is applied on the published page too, not just in the editor, so these
+   rules are part of the site, not part of the editing chrome.
+
+   The inner <section> keeps its own padding classes; [data-ws-pad] zeroes them
+   and the wrapper re-applies the chosen rhythm. That is the only structural
+   override here, and it is scoped to sections that actually carry a style. */
+[data-ws-pad] > section {
+  padding-block: 0;
+}
+[data-ws-pad] {
+  padding-block: 5rem;
+}
+[data-ws-pad="none"] { padding-block: 0; }
+[data-ws-pad="compact"] { padding-block: 2.5rem; }
+[data-ws-pad="airy"] { padding-block: 7.5rem; }
+
+/* Backgrounds. The section's own cards and body copy keep their explicit
+   colours; only the two section-heading tokens flip, because the heading above
+   a dark band is the one thing that would otherwise be unreadable. */
+[data-ws-bg] { position: relative; }
+[data-ws-bg="surface"] { background: var(--brand-surface); }
+[data-ws-bg="accent"] { background: color-mix(in srgb, var(--brand-accent) 14%, white); }
+[data-ws-bg="dark"] {
+  background: var(--brand-secondary);
+  --brand-heading: #ffffff;
+  --brand-subheading: rgb(255 255 255 / 0.78);
+}
+[data-ws-bg="gradient"] {
+  background: linear-gradient(135deg, var(--brand-secondary) 0%, var(--brand-primary) 100%);
+  --brand-heading: #ffffff;
+  --brand-subheading: rgb(255 255 255 / 0.82);
+}
+
+/* Heading scale: one variable, so every section type scales the same way
+   instead of each one needing its own rule. */
+[data-ws-head="s"] { --ws-head-scale: 0.85; }
+[data-ws-head="m"] { --ws-head-scale: 1; }
+[data-ws-head="l"] { --ws-head-scale: 1.15; }
+[data-ws-head="xl"] { --ws-head-scale: 1.3; }
+[data-ws-head] { --ws-head-base: 1.875rem; }
+[data-ws-head] h2 {
+  font-size: calc(var(--ws-head-base) * var(--ws-head-scale));
+  line-height: 1.15;
+}
+@media (min-width: 768px) {
+  [data-ws-head] { --ws-head-base: 2.25rem; }
+}
+
+[data-ws-align="center"] > section :is(h2, h3, p) {
+  text-align: center;
+}
+
+/* Columns: grids inside a section read the count from here when it is set.
+   Sections that lay out with flex (a filmstrip) deliberately ignore it. */
+[data-ws-cols] > section :is(.grid) {
+  grid-template-columns: repeat(var(--ws-cols, 1), minmax(0, 1fr)) !important;
+}
+[data-ws-cols="1"] { --ws-cols: 1; }
+[data-ws-cols="2"] { --ws-cols: 2; }
+[data-ws-cols="3"] { --ws-cols: 3; }
+[data-ws-cols="4"] { --ws-cols: 4; }
+@media (max-width: 640px) {
+  [data-ws-cols] > section :is(.grid) {
+    grid-template-columns: repeat(min(var(--ws-cols, 1), 2), minmax(0, 1fr)) !important;
+  }
+}
+
+/* A dense section the owner keeps on desktop but hides on a phone. */
+@media (max-width: 640px) {
+  [data-ws-hide-mobile] { display: none; }
+}
